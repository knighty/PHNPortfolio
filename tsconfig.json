{
    "compilerOptions": {
        "removeComments": true,
        "sourceMap": true,
        "moduleResolution": "Node",
        "noImplicitAny": true,
        "module": "ESNext",
        "target": "ESNext",
        "strictNullChecks": false,
        "strictFunctionTypes": false,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
		"types": [
			"node"
		]
    },
    "exclude": [
        "node_modules",
        "**/node_modules/*"
    ],
    "ts-node": {
        "compilerOptions": {
            "module": "CommonJS"
        }
    }
}